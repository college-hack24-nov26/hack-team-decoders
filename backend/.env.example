# Copy to .env and fill in. Never commit the real .env.

# -- Application --
APP_NAME=MediKiosk
DEBUG=true

# -- Database --
# Local docker compose default; change host if running Postgres elsewhere.
DATABASE_URL=postgresql+psycopg2://medikiosk:medikiosk@localhost:5432/medikiosk

# -- Auth / JWT --
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -- ABDM / ABHA (Phase 1: mocked) --
# The AuthProvider interface ships with a MOCK implementation. Leave these blank
# until real ABDM sandbox credentials are available.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=

# ===========================================================================
# Phase 2 â€” Interview Engine (Module A)
# ===========================================================================

# -- ASR (speech-to-text) --
# Provider: "sarvam" | "whisper" | "azure" | "mock"
# Leave ASR_PROVIDER blank to auto-detect from whichever credentials are set,
# in the order sarvam -> whisper -> azure -> mock. Set it explicitly to pin one
# rather than have a stray key decide for you.
#
# "sarvam" is recommended: Saaras is built for Indian languages, accents and
# code-mixed speech, which is what patients actually produce. Needs
# SARVAM_API_KEY below (the same key serves STT and TTS).
# "azure" is Azure Speech Fast Transcription â€” real, verified working. Needs
# AZURE_SPEECH_REGION plus a key (see the Azure block at the bottom).
# With nothing configured you get a clearly-labelled mock transcript, so touch
# input and the rest of the interview stay testable.
#
# THIS ACCEPTS A CHAIN, and that is the recommended setting:
#
#   ASR_PROVIDER=sarvam,azure
#
# Providers are tried left to right until one returns a transcript. Sarvam credits
# are per account and run out one account at a time, so without a second rung the
# patient starts getting mock transcripts mid-demo. Mock is always appended as the
# final rung: a failed transcription must never end the interview, because the
# patient can still answer by touch.
ASR_PROVIDER=sarvam,azure

# --- Sarvam Saaras STT (ASR_PROVIDER=sarvam) ---
# saaras:v3 is Sarvam's documented default and the only model that honours
# SARVAM_STT_MODE. saaras:v4 is newer and covers 22 Indic languages.
SARVAM_STT_MODEL=saaras:v3
# transcribe | translate | verbatim | translit | codemix   (saaras:v3 only)
# Keep "transcribe": it preserves the patient's own language and normalises
# numbers. "translate" would silently render Hindi answers as English and throw
# away the original phrasing, which a clinical record should not do.
SARVAM_STT_MODE=transcribe
# NOTE: the REST endpoint caps one request at 30 seconds of audio.

# --- Whisper (ASR_PROVIDER=whisper) ---
# Any Whisper-compatible transcription endpoint, e.g.
#   https://api.openai.com/v1/audio/transcriptions
# Heads up: the hosted `whisper` model is scheduled to retire 2026-12-15.
WHISPER_API_URL=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# -- TTS (spoken question prompts) --
# Provider: "sarvam" | "google" | "azure" | "none", or a chain of them.
# "none" disables audio; prompts render text-only and the app still works.
#
# THIS ACCEPTS A CHAIN, and that is the recommended setting:
#
#   TTS_PROVIDER=sarvam,azure
#
# Tried left to right until one returns audio, for the same reason as ASR above:
# a spent Sarvam account should cost the patient nothing. Clips are cached per
# serving provider, so a Sarvam .wav and an Azure .mp3 of the same sentence never
# collide.
#
# "azure" is Azure Speech neural voices â€” real, verified working. It is also the
# only provider that can voice the full set of ten interface languages *plus*
# Odia, which Bulbul cannot speak at all. Needs AZURE_SPEECH_REGION plus a key
# (see the Azure block at the bottom).
TTS_PROVIDER=sarvam,azure

# Where synthesised clips are cached on disk. Prompts come from a fixed
# ontology, so the same few hundred strings repeat all day â€” the cache avoids
# paying for and waiting on an identical API call per patient.
TTS_CACHE_DIR=tts_cache

# --- Google Cloud Text-to-Speech (TTS_PROVIDER=google) ---
# Pick ONE of the two auth methods.
#
# 1. API key â€” simplest. Create at
#    console.cloud.google.com â†’ APIs & Services â†’ Credentials.
#    Restrict it to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=
#
# 2. Service-account JSON â€” the production path. Download the key file and point
#    this at its absolute path. Requires `pip install google-auth`.
#    Do NOT commit the .json; keep it outside the repo or in a gitignored dir.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Google AI shared key pool (TTS + Vision OCR + Gemini) ---
#
# All three Google services draw from a single rotating pool. When one key's
# quota runs out, the next key takes over automatically â€” no restart, no manual
# intervention.  This mirrors the Sarvam pool exactly.
#
# ===========================================================================
# HOW TO PASTE YOUR TEAM'S GOOGLE AI KEYS â€” read this bit, ignore the rest
# ===========================================================================
#
# Got ONE key?  Put it on the GOOGLE_AI_API_KEY line and you are done:
#
#     GOOGLE_AI_API_KEY=AIzaSy...
#
# Got SEVERAL keys (one per teammate / GCP project)?  Use the numbered lines.
# Add one line per key, starting at _1. Leave GOOGLE_AI_API_KEY blank.
#
#     GOOGLE_AI_API_KEY_1=AIzaSy_first_key
#     GOOGLE_AI_API_KEY_2=AIzaSy_second_key
#     GOOGLE_AI_API_KEY_3=AIzaSy_third_key
#
# Keep going for as many as you have â€” _4, _5, _6, â€¦ There is NO limit and
# you do not tell the app how many there are; it counts them itself.
#
# Rules:
#   - NO quotes and NO spaces around the "=".
#   - Do not skip _1. Numbering starts at 1.
#   - Gaps are fine (_1 and _4 with nothing between).
#   - The same key pasted twice counts once (de-duplicated automatically).
#   - GOOGLE_TTS_API_KEY / GOOGLE_VISION_API_KEY (below) are still honoured
#     as legacy single-key fallbacks.  You can migrate at your own pace.
#   - RESTART the backend after editing this file. Keys are read once at boot.
#
# What the pool does:
#   - HTTP 401 / 402 / 403  â†’ key is exhausted (billing disabled, key revoked,
#     daily quota gone).  Parked permanently; the next key takes over.
#   - HTTP 429 with a per-minute rate-limit body  â†’ brief 60 s cooldown, then
#     back in service.
#   - HTTP 429 with RESOURCE_EXHAUSTED / dailyLimitExceeded in the body  â†’
#     treated as permanently exhausted for the day, same as 403.
#   - HTTP 400 / other client errors  â†’ NOT a key problem; the pool does not
#     rotate so a bad request doesn't burn every key.
#   - All three Google services (TTS, Vision OCR, Gemini) share this pool, so
#     one key running out loses all three simultaneously and fails over to the
#     next key for all three at once.
#
# Check it worked: open http://localhost:8000/health and look for "google_keys".
#
# ===========================================================================

# Single key. Leave blank if you are using the numbered lines below.
GOOGLE_AI_API_KEY=

# Your teammates' keys, one per line. Uncomment and fill in as many as you have.
# GOOGLE_AI_API_KEY_1=
# GOOGLE_AI_API_KEY_2=
# GOOGLE_AI_API_KEY_3=
# GOOGLE_AI_API_KEY_4=
# GOOGLE_AI_API_KEY_5=
# GOOGLE_AI_API_KEY_6=

# Alternative: all keys on one line, comma-separated.
# GOOGLE_AI_API_KEYS=AIzaSy_first,AIzaSy_second,AIzaSy_third
GOOGLE_AI_API_KEYS=

# --- Sarvam AI (STT + TTS + OCR) ---
# One Sarvam key covers ALL THREE services: Saaras (speech-to-text),
# Bulbul (text-to-speech) and Sarvam Vision (document OCR).
# Get one at dashboard.sarvam.ai -> Generate API Key.
#
# ===========================================================================
# HOW TO PASTE YOUR TEAM'S KEYS  â€”  read this bit, ignore the rest
# ===========================================================================
#
# Got ONE key? Put it on the SARVAM_API_KEY line and you are done:
#
#     SARVAM_API_KEY=sk_abc123...
#
# Got SEVERAL keys (one per teammate)? Use the numbered lines instead. Add one
# line per key, starting at _1 and counting up. Leave SARVAM_API_KEY blank.
#
#     SARVAM_API_KEY_1=sk_first_persons_key
#     SARVAM_API_KEY_2=sk_second_persons_key
#     SARVAM_API_KEY_3=sk_third_persons_key
#     SARVAM_API_KEY_4=sk_fourth_persons_key
#
# Keep going for as many as you have â€” _5, _6, _7, _12, whatever. There is NO
# limit and you do not tell the app how many there are; it counts them itself.
# Blank lines are ignored, so leaving spares in place does no harm.
#
# Rules that save you debugging later:
#   - NO quotes and NO spaces around the "=".  SARVAM_API_KEY_1=sk_abc  (right)
#                                              SARVAM_API_KEY_1 = "sk_abc" (wrong)
#   - Do not skip _1. Numbering starts at 1.
#   - Gaps are fine (_1 and _4 with nothing between) if someone drops out.
#   - The same key pasted twice counts once, so no harm in duplicates.
#   - RESTART the backend after editing this file. Nothing re-reads it live.
#
# Check it worked: open http://localhost:8000/health and look at "sarvam_keys".
# "total" is how many keys it found. If that number is wrong, the paste is wrong.
#
#     "sarvam_keys": {"total": 4, "available": 4, "exhausted": 0, "cooling_down": 0}
#
# ===========================================================================

# Single key. Leave blank if you are using the numbered lines below.
SARVAM_API_KEY=

# Your teammates' keys, one per line. Uncomment and fill in as many as you have.
# SARVAM_API_KEY_1=
# SARVAM_API_KEY_2=
# SARVAM_API_KEY_3=
# SARVAM_API_KEY_4=
# SARVAM_API_KEY_5=
# SARVAM_API_KEY_6=

# Alternative to the numbered lines: all keys on one line, comma-separated.
# Order is the order they get spent. Mixing both styles is allowed.
# SARVAM_API_KEYS=sk_first,sk_second,sk_third
SARVAM_API_KEYS=

# --- How the pool behaves (no action needed, just so it is not surprising) ---
#   - The first working key serves every request. There is no round-robin, so
#     one account is fully spent before the next is touched.
#   - Out of credit (HTTP 401/402/403) parks that key until the next restart.
#     It is never retried, so a dead account costs one failed request, not a
#     wasted round-trip on every call after it.
#   - Rate limited (HTTP 429 â€” Sarvam allows 10 requests/minute on every plan)
#     is temporary: that key rests for a minute, then comes back.
#   - A bad file or bad request (400/413/422) does NOT rotate keys. Those fail
#     the same way on every key, so rotating would burn the whole pool on one
#     broken upload.
#   - Speech, audio and OCR share the same pool state, so an account that runs
#     out mid-visit fails over for all three at once.
#   - Topped up an account? Restart the backend so it stops being treated as
#     spent.

# bulbul:v3 is current. bulbul:v2 is Sarvam-designated legacy and is rejected
# outright by self-hosted Sarvam endpoints â€” only set it to fall back in a pinch.
# v3 allows 2500 chars per request, v2 allows 1500.
SARVAM_MODEL=bulbul:v3

# Speakers are MODEL-SPECIFIC and lowercase. LEAVE BLANK to take Sarvam's own
# per-model default (shubh on v3, anushka on v2). That is the safe choice and the
# recommended one: a speaker from the wrong model version is rejected outright, so
# a stale name here means every request 400s and you lose all Sarvam audio. The
# code warns and falls back rather than failing, but a pinned name buys nothing
# the default does not already give you.
#   bulbul:v3 â€” female: ritu, priya, neha, pooja, simran, kavya, ishita, shreya,
#                       roopa, shruti, suhani, rupali, niharika, kavitha, tanya
#               male:   shubh, aditya, ashutosh, rahul, rohan, amit, dev, varun,
#                       manan, sumit, kabir, aayan, advait, anand, tarun, sunny,
#                       mani, gokul, vijay, mohit, rehan, soham, ratan
#   bulbul:v2 â€” female: anushka, manisha, vidya, arya
#               male:   abhilash, karun, hitesh
SARVAM_SPEAKER=

# NOTE: always feed Devanagari, never romanised Hindi. Sarvam documents that
# transliterated Indic input measurably degrades audio quality.

# --- Sarvam Vision Document AI (OCR_ENGINE=sarvam) ---
# The same SARVAM_API_KEY above also covers OCR. Sarvam Vision handles all 22
# constitutionally recognised Indian languages plus English, and is the only
# engine in this codebase that reads handwriting â€” which is what a real
# prescription usually is.
#
# Document AI uses `language` (not `language_code` like STT/TTS). This is only a
# hint; set it to the language you mostly expect on uploaded papers.
SARVAM_OCR_LANGUAGE=en-IN
SARVAM_OCR_MODEL=sarvam-vision-v1
#
# Document AI is an async job API: submit, poll, fetch. These cap how long a
# single upload will wait rather than holding the request open indefinitely.
SARVAM_OCR_TIMEOUT_SECONDS=120
SARVAM_OCR_POLL_SECONDS=2.0
#
# Published limits: 10 pages per PDF, 10 images per ZIP, 200 MB per file,
# 10 requests/minute on all plans. Accepted formats: PDF, PNG, JPG, ZIP.

# ===========================================================================
# Phase 3 â€” Document Digitization (Module B)
# ===========================================================================

# -- OCR engine --
# "sarvam"        â€” Sarvam Vision Document AI. RECOMMENDED. Best on Indian-language
#                   documents, reads handwriting, reuses SARVAM_API_KEY.
# "tesseract"     â€” local and free, but needs the `tesseract` binary installed on
#                   the host. Upload fails with a RuntimeError if it is missing.
# "google_vision" â€” cloud, 1000 free requests/month.
# "azure"         â€” STUB (task A4), raises NotImplementedError. Do not use.
OCR_ENGINE=sarvam

# Google Cloud Vision â€” only read when OCR_ENGINE=google_vision.
# Option A: API key. Simplest; needs no extra library beyond httpx.
GOOGLE_VISION_API_KEY=
# Option B: service-account JSON path. Needs the google-cloud-vision package
# (commented out in requirements.txt â€” uncomment it if you use this path).
GOOGLE_VISION_CREDENTIALS_PATH=

# -- Document blob storage --
# FILE_STORAGE_BACKEND: "local" (default) | "supabase"
FILE_STORAGE_BACKEND=local
FILE_STORAGE_BUCKET=medikiosk-documents
FILE_STORAGE_ROOT=./storage

# -- Supabase Storage (only when FILE_STORAGE_BACKEND=supabase) --
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=medikiosk-uploads

# -- CORS --
# Comma-separated allowed origins. Add your deployed frontend URL here.
# Use "*" to allow all origins (credentials will be disabled â€” OK for demos).
# Example (Render): CORS_ORIGINS=https://medikiosk-ui.onrender.com
# Example (wildcard): CORS_ORIGINS=*
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -- Bootstrap / seeding (for hosts with no shell, e.g. Render free tier) --
# Read once at app startup (see app/bootstrap.py). Unset = no-op.
#   seed  = ensure the demo doctors + the admin & physician logins exist
#           (idempotent, safe to leave set on every boot)
#   reset = ALSO wipe ALL patient/clinical data first. DESTRUCTIVE. Use ONCE,
#           then switch this back to "seed" or it wipes on every cold start.
#   demo  = reset, then build the full curated presentation dataset (7 patients
#           with visits, documents, transcripts and summaries â€” one returning
#           patient with two visits, two red-flag cases, and one case left
#           WITHOUT a summary for live generation). Also DESTRUCTIVE / a full
#           reset. Set once, redeploy, then switch back to "seed" so the next
#           cold start does not wipe anything created during the demo.
MEDIKIOSK_BOOTSTRAP=
# The single super-admin created by the bootstrap. A physician login for the
# dashboard (doctor@medikiosk.in) is created with this same password.
ADMIN_EMAIL=admin@medickiosk.in
ADMIN_PASSWORD=

# -- Document embeddings (pgvector similarity search) --
# EMBEDDING_PROVIDER: "azure" | "local" | "hash".
#   unset     â€” auto: Azure if Azure OpenAI is configured above, else "hash".
#   "azure"   â€” Azure OpenAI embeddings over REST. Needs an embeddings DEPLOYMENT
#               on the resource (the chat deployment is not enough). The vector is
#               requested at 384 dims to fit the vector(384) column.
#   "local"   â€” sentence-transformers/all-MiniLM-L6-v2. Pulls in torch (~2 GB), so
#               it is never auto-selected â€” set this explicitly and add
#               sentence-transformers to the environment.
#   "hash"    â€” deterministic pseudo-embedding. Not semantic, but needs nothing;
#               the plumbing works and tests stay offline. Fine for the demo.
# A real provider that fails degrades to "hash" so document upload never breaks.
EMBEDDING_PROVIDER=
# Azure: the embeddings deployment name (default text-embedding-3-small).
# Local: the sentence-transformers model id.
EMBEDDING_MODEL=

# ===========================================================================
# Phase 4 â€” Summary Generator (Module C)
# ===========================================================================
#
# Three paths are tried in order and the first that works wins. The chosen path
# is recorded on the summary as `generated_by`, so the physician can see whether
# a draft came from a hosted model, a local one, or from rule-based assembly.
#
#   1. main_api        hosted LLM, best quality, needs connectivity
#   2. local_offline   local model, works without internet
#   3. deterministic   no model at all: reformats the interview answers
#
# The deterministic path needs no configuration and always succeeds, so leaving
# everything below blank gives a working summariser that cannot hallucinate â€”
# it only copies what the patient actually answered.

# -- Main API path (hosted) --
# Provider: "openai" (default) | "gemini"
MAIN_LLM_PROVIDER=openai

# --- OpenAI (MAIN_LLM_PROVIDER=openai) ---
# Any OpenAI-compatible chat-completions endpoint.
# Key from: https://platform.openai.com/api-keys
MAIN_LLM_API_KEY=
MAIN_LLM_ENDPOINT=         # blank = https://api.openai.com/v1/chat/completions
MAIN_LLM_MODEL=gpt-4o-mini

# --- Google Gemini (MAIN_LLM_PROVIDER=gemini) ---
# Key from: https://aistudio.google.com/apikey (free tier available)
# Swap the three lines below (comment out OpenAI, uncomment Gemini):
# MAIN_LLM_PROVIDER=gemini
# MAIN_LLM_API_KEY=your_gemini_key_here
# MAIN_LLM_MODEL=gemini-2.0-flash

# -- Local Offline path --
# Ollama or compatible. Kept in separate settings from the Main API so the two
# can be configured, and fail, independently.
LOCAL_LLM_ENDPOINT=
LOCAL_LLM_MODEL=llama3.2

# ===========================================================================
# Azure AI Services (all optional â€” existing providers remain as fallbacks)
# ===========================================================================
# The team has $4000 in Azure startup credits. When configured, Azure services
# take priority over existing providers. Without these vars, the app works
# exactly as before (Whisper/Sarvam/Tesseract/mock fallbacks).
#
# See docs/dev/azure-provisioning-guide.md for step-by-step setup.

# -- Azure OpenAI / Microsoft Foundry (LLM summariser, main_api path) --
# Create at: portal.azure.com or ai.azure.com â†’ deploy a chat model.
#
# Model choice: gpt-5.4-mini is the recommended default â€” GA until 2027-09-21
# and cheap enough for structured extraction, which is all this path does.
# Avoid gpt-4o: every version is Deprecated or Legacy, and the 2024-05-13
# version retires 2026-10-01. Microsoft's own replacement for it is gpt-5.1.
#
# Paste the endpoint exactly as the portal shows it. Both resource shapes work:
#   Azure OpenAI resource : https://<resource-name>.openai.azure.com
#   Foundry resource      : https://<resource-name>.services.ai.azure.com
# The app appends /openai/v1 itself, so no api-version is needed.
#
# Setting the endpoint + key makes Azure the main_api provider automatically. An
# explicit MAIN_LLM_ENDPOINT or MAIN_LLM_PROVIDER=gemini always takes precedence.
AZURE_OPENAI_ENDPOINT=          # see both accepted shapes above
AZURE_OPENAI_API_KEY=           
AZURE_OPENAI_DEPLOYMENT=        # the DEPLOYMENT name you chose, NOT the model name
#
# No AZURE_OPENAI_API_VERSION: the v1 API drops the dated api-version parameter.
# Nothing to set for temperature either â€” GPT-5.x and the o-series reject it, and
# the code omits it for those models and retries without it if a deployment name
# it did not recognise turns out to be a reasoning model.

# -- Azure Speech (STT + TTS, both verified working) --
#
# YOU MAY NOT NEED A KEY HERE. A multi-service Azure AI Services / Foundry
# resource issues ONE key covering OpenAI, Speech, Vision and Document
# Intelligence, so when AZURE_SPEECH_KEY is blank the code falls back to
# AZURE_OPENAI_API_KEY above. Set this only if Speech lives in its own resource.
AZURE_SPEECH_KEY=               
#
# THE REGION IS NOT OPTIONAL and cannot be guessed. A key is scoped to the region
# its resource lives in, and the wrong region returns 401 rather than redirecting.
# Find it in the portal on the resource's Overview page. Note the default below is
# where an Indian deployment *belongs*, not where any given resource *is* â€” the
# team's current resource is in eastus2.
#
# Worth knowing: Azure Speech processes data only in its resource's region. A
# non-India region means patient voice recordings leave the country, which is a
# question the DPDP consent story has to be able to answer.
AZURE_SPEECH_REGION=centralindia
#
# Voices are chosen per language in app/interview/tts.py (_AZURE_VOICES) and cover
# all ten interface languages plus Odia. Nothing to configure here.
# One vendor quirk handled in code: the language registry follows Sarvam and
# spells Odia "od-IN", while Azure wants ISO "or-IN" and rejects "od-IN".

# -- Azure Document Intelligence (high-quality OCR) --
# Create at: portal.azure.com â†’ "Document Intelligence"
# Uses prebuilt-read and prebuilt-layout models (no custom training needed)
AZURE_DOC_INTELLIGENCE_ENDPOINT=  # https://<resource-name>.cognitiveservices.azure.com
AZURE_DOC_INTELLIGENCE_KEY=       

# ===========================================================================
# Phase 6 â€” Consent, Privacy & ABDM (Module D)
# ===========================================================================

# -- ABHA identity --
# Blank uses the clearly-labelled MOCK AuthProvider, which performs no real
# identity check and issues a session to anyone entering a well-formed number.
# See app/services/auth_provider.py for the swap-in steps for a real sandbox.
ABHA_SANDBOX_BASE_URL=

# -- FHIR push destination --
# Where a confirmed summary's FHIR R4 Bundle is POSTed.
#   blank                                        Bundle is generated but NOT sent
#                                                (the API response says so)
#   http://localhost:8000/api/v1/abdm-mock/fhir  local MOCK receiver â€” real HTTP,
#                                                real FHIR, not real ABDM
#   <ABDM Health Repository URL>                 production
ABDM_FHIR_ENDPOINT=

# -- Data retention (DPDP Act 2023) --
# Delete raw document scans and voice transcripts once a summary reaches the
# HIS. Structured clinical data, consent records and audit logs are never
# purged, since those are the consented record and the compliance trail.
PURGE_AFTER_PUSH=true
